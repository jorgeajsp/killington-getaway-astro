---
// Footer component - Pure Astro (static)
---

<footer style="background-color: #121D21" class="text-white text-center">
  <!-- Brand Partners -->
  <div class="py-8 border-b border-gray-700 px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-6 text-center">Ski Brand Partners</p>
    <div class="flex justify-center items-center gap-12 flex-wrap">
      <a href="https://www.stio.com/" target="_blank" rel="noopener noreferrer">
        <img src="/stio-logo.png" alt="Stio" width="110" height="35" style="height: 35px; width: 110px; object-fit: contain; filter: brightness(0) invert(1)" />
      </a>
      <a href="https://www.smithoptics.com/" target="_blank" rel="noopener noreferrer">
        <img src="/smith-logo.png" alt="Smith" width="110" height="35" style="height: 35px; width: 110px; object-fit: contain; filter: brightness(0) invert(1)" />
      </a>
      <a href="https://www.hellyhansen.com/" target="_blank" rel="noopener noreferrer">
        <img src="/helly-hansen-logo.png" alt="Helly Hansen" width="110" height="35" style="height: 35px; width: 110px; object-fit: contain; filter: brightness(0) invert(1)" />
      </a>
      <a href="https://www.dakine.com/" target="_blank" rel="noopener noreferrer">
        <img src="/dakine-logo.png" alt="Dakine" width="110" height="35" style="height: 35px; width: 110px; object-fit: contain; filter: brightness(0) invert(1)" />
      </a>
      <a href="https://www.clifbar.com/" target="_blank" rel="noopener noreferrer">
        <img src="/clif-logo.png" alt="Clif Bar" width="110" height="35" style="height: 35px; width: 110px; object-fit: contain; filter: brightness(0) invert(1)" />
      </a>
    </div>
  </div>

  <!-- 4-Column Grid -->
  <div style="background-color: #121D21" class="px-6 py-12 border-b border-gray-700">
    <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 text-center">
      <div class="flex flex-col gap-3 items-center">
        <a href="/">
          <img src="/logo-white.png" alt="Killington Getaway" width="120" height="40" style="width: 120px; margin-top: -30px" class="hover:opacity-80 transition-opacity cursor-pointer mx-auto" />
        </a>
        <div class="flex gap-4 items-center justify-center" style="margin-top: -10px; margin-bottom: 5px">
          <a href="https://facebook.com/killingtongetaway" aria-label="Facebook" class="text-gray-400 hover:text-white p-3 inline-flex items-center justify-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://instagram.com/official_killingtongetaway" aria-label="Instagram" class="text-gray-400 hover:text-white p-3 inline-flex items-center justify-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://x.com/visitkillington" aria-label="Twitter / X" class="text-gray-400 hover:text-white p-3 inline-flex items-center justify-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/killington-getaway" aria-label="LinkedIn" class="text-gray-400 hover:text-white p-3 inline-flex items-center justify-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
