        <a href="https://www.trustpilot.com/review/killingtongetaway.com" target="_blank" rel="noopener noreferrer">
          <img src="/trustpilot-logo.png" alt="Trustpilot" width="120" height="37" style="height: 37px; width: 120px; object-fit: contain" />
        </a>
      </div>

      <div class="flex flex-col gap-3 items-center">
        <p class="text-white font-bold text-sm uppercase tracking-wider mb-2">More Info</p>
        <a href="/privacy-policy" class="text-gray-400 hover:text-white text-sm">Privacy Policy</a>
        <a href="/terms-of-use" class="text-gray-400 hover:text-white text-sm">Terms of Service</a>
        <a href="/affiliates" class="text-gray-400 hover:text-white text-sm">Affiliates</a>
        <a href="/certified-b-corp" class="text-gray-400 hover:text-white text-sm">Sustainability</a>
      </div>

      <div class="flex flex-col gap-3 items-center">
        <p class="text-white font-bold text-sm uppercase tracking-wider mb-2">For Locals</p>
        <a href="/local-contractors" class="text-gray-400 hover:text-white text-sm">Find A Contractor</a>
        <a href="https://www.indeed.com/l-Killington,-VT-jobs.html" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white text-sm">Jobs</a>
        <a href="/press-inquiries" class="text-gray-400 hover:text-white text-sm">Press</a>
        <a href="https://www.pinkbike.com/buysell/list/?region=3&q=Vermont" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white text-sm">Buy / Sell</a>
      </div>

      <div class="flex flex-col gap-3 items-center">
        <p class="text-white font-bold text-sm uppercase tracking-wider mb-2">Company</p>
        <a href="/our-team" class="text-gray-400 hover:text-white text-sm">Our Team</a>
        <a href="/contact-us" class="text-gray-400 hover:text-white text-sm">Contact Us</a>
        <a href="tel:+19494366769" class="text-gray-400 hover:text-white text-sm flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (949) 436-SNOW
        </a>
        <a href="mailto:hello@killingtongetaway.com" class="text-gray-400 hover:text-white text-sm flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          hello@killingtongetaway.com
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="py-6 flex flex-col items-center gap-2">
    <p class="text-gray-400 text-sm">Made in VT with ❤️ + ❄️</p>
    <p class="text-gray-500 text-xs">© 2026 Killington Getaway. All Rights Reserved.</p>
