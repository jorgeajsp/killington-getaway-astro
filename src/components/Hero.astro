---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  opacity?: number;
}

const {
  title,
  subtitle,
  image = "/images/hero/autumn-1.webp",
  opacity = 1
} = Astro.props;

const baseNavy = 50 * opacity;
const baseBlue = 20 * opacity;
const baseMultiply = 20 * opacity;
---

<div class="relative w-full pt-52 pb-44 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover object-center"
    />
  </div>
  <!-- Overlay: Reduced opacity and enhanced blue emphasis -->
  <div
    class="absolute inset-0 z-0"
    style={`background: linear-gradient(to top right, rgba(10, 31, 56, ${baseNavy / 100}), rgba(45, 148, 227, ${baseBlue / 100}), transparent)`}
  />
  <div
    class="absolute inset-0 z-0 mix-blend-multiply"
    style={`background-color: rgba(10, 31, 56, ${baseMultiply / 100})`}
  />

  <div class="relative max-w-4xl mx-auto px-6 z-10 text-center">
    <div class="inline-block w-12 h-1 bg-brand-blue mb-8 rounded-full shadow-[0_0_15px_rgba(45,148,227,0.5)]"></div>
    <h1 class="text-5xl md:text-7xl font-heading font-black text-white leading-[0.95] tracking-tight drop-shadow-2xl mb-6 uppercase">
      <Fragment set:html={title} />
    </h1>
    {subtitle && (
      <p class="text-white/90 text-xl md:text-2xl font-medium tracking-wide drop-shadow-lg">
        <Fragment set:html={subtitle} />
      </p>
    )}
  </div>
</div>
