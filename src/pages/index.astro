---

<BaseLayout title="Killington Getaway - Your Vermont Adventure Starts Here">
  <main class="bg-white font-sans">

    <!-- Hero Section with Rotating Images -->
    <section class="relative flex flex-col items-center justify-center overflow-hidden min-h-[800px] pb-16">
      <div class="hero-slideshow absolute inset-0">
        {heroImages.map((img, i) => (
          <img
            src={img.src}
            alt={img.alt}
            class={`hero-image absolute inset-0 w-full h-full object-cover ${i === 0 ? 'active' : ''}`}
          />
        ))}
      </div>

      <div class="relative z-10 text-center text-white px-6 max-w-5xl mx-auto w-full">
        <p class="uppercase tracking-widest text-sm font-semibold mb-5 text-white hero-text-shadow">
          Killington, Vermont
        </p>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold mb-6 leading-tight tracking-tight hero-text-shadow">
          Your Ultimate<br /><span class="text-brand-green hero-text-shadow">Adventure</span> Getaway
        </h1>
        <p class="text-white text-lg md:text-xl mb-10 max-w-3xl mx-auto font-medium leading-relaxed hero-text-shadow">
          Discover the best restaurants, breweries, ski shops, hiking trails and more in the heart of Vermont. Plan your ultimate adventure getaway with our curated local guide.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href="/listings" class="text-white font-bold px-10 py-4 rounded-full text-lg hover:opacity-90 transition-opacity shadow-xl uppercase tracking-wider bg-brand-green">
            Browse All Listings
          </a>
        </div>
      </div>
    </section>

    <!-- Search Bar -->
    <section class="bg-white py-8 px-6 border-b border-gray-100">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-extrabold text-black mb-4">
          Search Below to Find Killington's Top Activities
        </h2>
        <hr class="border-gray-200 mb-6" />
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-stretch">
          <input
            type="text"
            id="search-input"
            placeholder="What are you looking for"
            class="flex-1 min-w-0 border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 bg-white focus:outline-none focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 shadow-sm"
          />
          <select
            id="category-select"
            class="flex-1 min-w-0 border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 bg-white focus:outline-none focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 cursor-pointer shadow-sm"
          >
            <option value="" selected>Category</option>
            {CATEGORIES.map((cat) => (
              <option value={cat.slug}>
                {cat.emoji} {cat.name} ({cat.count})
              </option>
            ))}
          </select>
          <input
            type="text"
            id="location-input"
            placeholder="Town or ZIP code"
            class="flex-1 min-w-0 border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-700 bg-white focus:outline-none focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 shadow-sm"
          />
          <button
            id="search-button"
            class="flex-shrink-0 text-white font-bold px-8 py-3 rounded-lg text-sm tracking-widest uppercase hover:opacity-90 transition-opacity shadow-sm bg-brand-green"
          >
            SEARCH
          </button>
        </div>
        <p class="text-gray-400 text-sm mt-4">
          View all ({allListings.length}) listings and activities at Killington
        </p>
      </div>
    </section>

    <!-- Category Grid -->
    <section class="bg-white py-12 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-4xl md:text-5xl font-extrabold text-black mb-3 tracking-tight">
            Explore Killington
          </h2>
          <p class="text-gray-400 text-lg">Browse {allListings.length} handpicked spots across {CATEGORIES_RAW.length} categories</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 max-w-6xl mx-auto">
          {CATEGORIES.map((cat) => (
            <a
              href={`/listings?category=${cat.slug}`}
              class="flex flex-col items-center justify-center gap-3 border border-gray-100 rounded-2xl py-7 px-3 text-center group bg-white hover:shadow-md hover:border-brand-green transition-all duration-200"
            >
              <span class="text-4xl">{cat.emoji}</span>
              <span class="text-sm font-semibold text-gray-700 group-hover:text-brand-green leading-tight transition-colors">
                {cat.name}
              </span>
              <span class="text-xs text-gray-400">{cat.count} listings</span>
            </a>
          ))}
        </div>

        <div class="text-center mt-10">
          <a
            href="/listings"
            class="inline-block text-white font-bold px-10 py-4 rounded-full text-base hover:opacity-90 transition-opacity shadow-md bg-brand-green"
          >
            Browse All Listings
          </a>
        </div>
      </div>
    </section>

    <!-- Accommodations Slider -->
    <section class="bg-gray-50 py-12">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-extrabold text-black mb-3 tracking-tight text-center">
          Top Picks for Accommodation
        </h2>
        <p class="text-center text-gray-400 text-lg mb-8">Handpicked stays near Killington, Vermont</p>
      </div>

      <div
        id="accommodations-slider"
        class="overflow-x-auto pb-8 snap-x snap-mandatory hide-scrollbar flex"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        <div class="flex gap-6 px-6 md:px-[calc((100vw-80rem)/2+1.5rem)]">
          {AIRBNB_LISTINGS.map(({ id, title, rating, guests, details, location, img, params }) => {
            const href = `https://www.airbnb.com/rooms/${id}?${params}`;
            return (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-shrink-0 snap-center block bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md hover:border-brand-green/40 transition-all duration-300 group"
                style="width: min(85vw, 290px); margin: 0;"
              >
                <div class="relative aspect-[3/2] overflow-hidden bg-gray-100">
                  <img
                    src={img}
                    alt={title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute top-3 left-3 bg-brand-navy/85 backdrop-blur-sm text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full flex items-center gap-1 shadow-sm">
                    ⭐ {rating}
                  </div>
                  <div class="absolute bottom-3 right-3 bg-white/90 backdrop-blur-sm text-gray-800 text-[10px] font-extrabold px-2 py-0.5 rounded shadow-sm">
                    {guests}
                  </div>
                </div>

                <div class="p-4 flex flex-col justify-between h-[115px]">
                  <div>
                    <div class="flex justify-between items-start gap-1 mb-1">
                      <p class="text-[10px] uppercase tracking-wider font-extrabold text-brand-green">
                        {location}
                      </p>
                    </div>
                    <h3 class="text-sm font-bold text-black leading-snug group-hover:text-brand-green transition-colors line-clamp-2">
                      {title}
                    </h3>
                  </div>
                  <p class="text-xs font-semibold text-gray-400">
                    {details}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <div class="flex justify-center items-center gap-2 mt-5">
        {AIRBNB_LISTINGS.map((_, i) => (
          <button
            class="accommodation-dot rounded-full transition-all duration-300"
            data-index={i}
            aria-label={`Go to listing ${i + 1}`}
            style={{
              width: i === 0 ? '24px' : '10px',
              height: '10px',
              backgroundColor: i === 0 ? '#2d94e3' : '#D1D5DB',
              flexShrink: 0,
            }}
          />
        ))}
      </div>
    </section>

    <!-- Weather Widget -->
    <section class="bg-white py-10 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-4xl md:text-5xl font-extrabold text-black mb-3 tracking-tight">
            Weather Conditions
          </h2>
          <p class="text-gray-400 text-lg">Current conditions at Killington, Vermont</p>
        </div>
        <WeatherWidget client:load />
      </div>
    </section>

    <!-- Most Popular Searches -->
    <section class="bg-white py-12 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-4xl md:text-5xl font-extrabold text-black mb-3 tracking-tight">
            Most Popular Searches
          </h2>
          <p class="text-gray-400 text-lg">What visitors are looking for most</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {[
            { title: "Grocery Markets",     href: "/listings?category=grocery",         img: "https://images.unsplash.com/photo-1542838132-92c53300491e?w=600&q=80",  alt: "Grocery markets near Killington" },
            { title: "Ski Shops & Rentals", href: "/listings?category=ski-shops",       img: "https://images.unsplash.com/photo-1551698618-1dfe5d97d256?w=600&q=80",  alt: "Ski shops near Killington" },
            { title: "Après-Ski Nightlife", href: "/listings?category=places-to-drink", img: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=600&q=80", alt: "Apres ski nightlife Killington" },
          ].map((item) => (
            <a
              href={item.href}
              class="relative rounded-2xl overflow-hidden cursor-pointer group h-[280px]"
            >
              <img
                src={item.img}
                alt={item.alt}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-black/25 group-hover:bg-black/15 transition-colors"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <h3 class="text-white font-bold text-2xl text-center drop-shadow-lg px-4">
                  {item.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Deals of the Day -->
    <section class="bg-gray-50 py-12 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-4xl md:text-5xl font-extrabold text-black mb-3 tracking-tight">
            Deals of the Day
          </h2>
          <p class="text-gray-400 text-lg">Hand-picked gear from our partner brands — via Backcountry.com</p>
        </div>
      </div>
      <div
        id="deals-slider"
        class="flex gap-5 overflow-x-auto pb-10 snap-x snap-mandatory hide-scrollbar"
        style={{
          paddingLeft: 'max(1.5rem, calc((100vw - 80rem) / 2 + 1.5rem))',
          paddingRight: 'max(1.5rem, calc((100vw - 80rem) / 2 + 1.5rem))',
          scrollbarWidth: 'none',
          msOverflowStyle: 'none',
        }}
      >
        {DEALS.map((deal) => (
          <a
            href={deal.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-shrink-0 w-[min(80vw,18rem)] bg-white rounded-[2.5rem] shadow-sm border border-gray-100 overflow-hidden hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 group snap-center"
          >
            <div class="w-full h-64 bg-gray-50/50 flex items-center justify-center p-8 overflow-hidden relative">
              <div class="absolute inset-0 opacity-[0.03] pointer-events-none flex items-center justify-center text-4xl font-black uppercase tracking-tighter">
                {deal.brand}
              </div>
              <img
                src={deal.img}
                alt={`${deal.brand} ${deal.name}`}
                loading="lazy"
                class="w-full h-full object-contain relative z-10 group-hover:scale-110 transition-transform duration-700"
              />
            </div>
            <div class="p-8 text-center">
              <p class="text-[10px] font-black uppercase tracking-[0.2em] mb-2 text-brand-green">
                {deal.brand}
              </p>
              <h3 class="text-base font-bold text-gray-900 mb-2 leading-tight h-10 line-clamp-2">{deal.name}</h3>

              <div class="flex justify-center gap-0.5 mb-4 text-amber-400 text-xs">
                {[...Array(5)].map((_, i) => (
                  <span key={i}>{i < Math.floor(deal.rating) ? '★' : '☆'}</span>
                ))}
              </div>

              <div class="flex items-center justify-center gap-3 mb-6">
                <span class="text-2xl font-black text-gray-900">{deal.price}</span>
              </div>

              <div
                class="inline-flex items-center gap-2 text-[10px] font-black px-8 py-4 rounded-full text-white transition-all shadow-lg group-hover:shadow-brand-green/20 bg-brand-green"
              >
                SHOP NOW
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Blog Posts -->
    <section class="bg-white py-12 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-4xl md:text-5xl font-extrabold text-black mb-3 tracking-tight">
            Must Read Stories & Travel Advice
          </h2>
          <p class="text-gray-400 text-lg">Inspiration and guides from Killington</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {latestPosts.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-200 group flex flex-col"
            >
              <div class="h-44 overflow-hidden">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-5 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span
                    class="text-xs font-bold px-2.5 py-1 rounded-full text-white"
                    style={`background-color: ${categoryColors[post.data.category] || '#2d94e3'}`}
                  >
                    {post.data.category}
                  </span>
                  <span class="text-xs text-gray-400">{new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </div>
                <h3 class="text-sm font-bold text-gray-900 mb-2 leading-snug line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="text-xs text-gray-500 mb-4 line-clamp-2 flex-1 leading-relaxed">
                  {post.data.excerpt}
                </p>
                <span class="text-xs font-semibold hover:underline text-brand-green">
                  Read More →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-image {
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-image.active {
    opacity: 1;
    animation: slow-zoom 6s ease-out forwards;
  }

  @keyframes slow-zoom {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.05);
    }
  }

  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .hero-text-shadow {
    text-shadow:
      0 2px 4px rgba(0, 0, 0, 0.5),
      0 4px 8px rgba(0, 0, 0, 0.4),
      0 8px 16px rgba(0, 0, 0, 0.3);
  }
</style>

<script>
  // Hero slideshow
  const images = document.querySelectorAll('.hero-image');
  let currentIndex = 0;

  function showNextImage() {
    images[currentIndex].classList.remove('active');
    currentIndex = (currentIndex + 1) % images.length;
    images[currentIndex].classList.add('active');
  }

  setInterval(showNextImage, 6000);

  // Search functionality
  const searchButton = document.getElementById('search-button');
  const categorySelect = document.getElementById('category-select') as HTMLSelectElement;

  if (searchButton && categorySelect) {
    searchButton.addEventListener('click', () => {
      const category = categorySelect.value;
      if (category) {
        window.location.href = `/listings?category=${category}`;
      } else {
        window.location.href = '/listings';
      }
    });
  }

  // Accommodations slider auto-scroll
  const accommodationsSlider = document.getElementById('accommodations-slider');
  const accommodationDots = document.querySelectorAll('.accommodation-dot');
  let isPaused = false;
  let activeDot = 0;
  const CARD_W = 290;
  const CARD_GAP = 24;
  const CARD_STRIDE = CARD_W + CARD_GAP;

  if (accommodationsSlider) {
    accommodationsSlider.addEventListener('mouseenter', () => { isPaused = true; });
    accommodationsSlider.addEventListener('mouseleave', () => { isPaused = false; });

    accommodationsSlider.addEventListener('scroll', (e) => {
      const el = e.currentTarget as HTMLElement;
      const newDot = Math.round(el.scrollLeft / CARD_STRIDE);
      if (newDot !== activeDot) {
        accommodationDots[activeDot]?.setAttribute('style', 'width: 10px; height: 10px; background-color: #D1D5DB;');
        activeDot = newDot;
        accommodationDots[activeDot]?.setAttribute('style', 'width: 24px; height: 10px; background-color: #2d94e3;');
      }
    });

    setInterval(() => {
      if (isPaused || !accommodationsSlider) return;
      const maxScroll = accommodationsSlider.scrollWidth - accommodationsSlider.clientWidth;
      if (accommodationsSlider.scrollLeft >= maxScroll - 10) {
        accommodationsSlider.scrollTo({ left: 0, behavior: 'smooth' });
        activeDot = 0;
      } else {
        accommodationsSlider.scrollBy({ left: CARD_STRIDE, behavior: 'smooth' });
        activeDot = Math.min(activeDot + 1, accommodationDots.length - 1);
      }
    }, 5000);

    accommodationDots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        accommodationsSlider.scrollTo({ left: i * CARD_STRIDE, behavior: 'smooth' });
        accommodationDots[activeDot]?.setAttribute('style', 'width: 10px; height: 10px; background-color: #D1D5DB;');
        activeDot = i;
        dot.setAttribute('style', 'width: 24px; height: 10px; background-color: #2d94e3;');
      });
    });
  }

  // Deals slider auto-scroll
  const dealsSlider = document.getElementById('deals-slider');
  if (dealsSlider) {
    dealsSlider.addEventListener('mouseenter', () => { isPaused = true; });
    dealsSlider.addEventListener('mouseleave', () => { isPaused = false; });

    setInterval(() => {
      if (isPaused || !dealsSlider) return;
      const maxScroll = dealsSlider.scrollWidth - dealsSlider.clientWidth;
      if (dealsSlider.scrollLeft >= maxScroll - 10) {
        dealsSlider.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        dealsSlider.scrollBy({ left: 228, behavior: 'smooth' });
      }
    }, 4000);
  }
</script>
