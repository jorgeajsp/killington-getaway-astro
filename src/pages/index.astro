---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Get latest 3 blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<BaseLayout title="Killington Getaway - Your Vermont Adventure Starts Here">
  <main class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="relative h-[600px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/beast-of-the-east.png"
          alt="Killington Mountain"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-brand-navy/50"></div>
      </div>

      <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6">
          Welcome to Killington
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-8">
          Discover the Beast of the East - Vermont's Premier Four-Season Destination
        </p>
        <a
          href="/blog"
          class="inline-block bg-brand-blue text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-brand-green transition-colors"
        >
          Explore Our Blog
        </a>
      </div>
    </section>

    <!-- Latest Blog Posts -->
    <section class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-8">Latest Stories</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="group block bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300"
          >
            <div class="aspect-[16/9] overflow-hidden bg-gray-100">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-brand-blue transition-colors">
                {post.data.title}
              </h3>
              <p class="text-gray-600 text-sm line-clamp-2">
                {post.data.excerpt}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-brand-navy text-white py-16">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Plan Your Adventure?</h2>
        <p class="text-xl text-white/80 mb-8">
          Explore our comprehensive guides, local insights, and insider tips
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a
            href="/blog"
            class="bg-brand-blue text-white px-6 py-3 rounded-lg font-bold hover:bg-brand-green transition-colors"
          >
            Read the Blog
          </a>
          <a
            href="/listings"
            class="bg-white text-brand-navy px-6 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors"
          >
            Browse Listings
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
