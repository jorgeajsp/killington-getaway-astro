---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherWidget from '../components/react/WeatherWidget';

// Get latest 4 blog posts (filter out drafts and future-scheduled posts)
const now = new Date();
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => {
    if (post.data.draft) return false;
    const publishDate = post.data.publishDate ? new Date(post.data.publishDate) : new Date(post.data.date);
    return publishDate <= now;
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

// Import listings data
import listingsData from '../data/listings.json';
const allListings = listingsData.filter((l: any) => !l.draft);

// Category mapping
const CAT_MAP: Record<string, string> = {
  'places to eat': 'places-to-eat',
  'breweries': 'breweries',
  'ski shops': 'ski-shops',
  'hiking': 'hiking',
  'hiking trails': 'hiking',
  'golf': 'golf',
  'golf courses': 'golf',
  'lodging options': 'lodging-options',
  'adventure experience': 'adventure',
  'places to drink': 'places-to-drink',
  'waterfalls': 'waterfalls',
  'farm visits': 'farm-visits',
  'museum experience': 'museums',
  'nordic ski': 'nordic-ski',
  'cheese shops': 'cheese',
  'covered bridges': 'bridges',
  'bakery & cafes': 'cafe',
  'rock climbing': 'climbing',
  'snowmobile tours': 'snowmobile',
  'spa day': 'spa',
  'paddle board': 'sup',
  'maple sugar': 'maple',
  'grocery markets': 'grocery',
  'ev charging': 'ev-charging',
};

function getListingSlugs(listing: any) {
  return (listing.categories || []).map((c: string) => CAT_MAP[c.toLowerCase().trim()] || null).filter(Boolean);
}

const CATEGORIES_RAW = [
  { name: "Places to Eat",     slug: "places-to-eat",   emoji: "🍽️" },
  { name: "Local Breweries",   slug: "breweries",        emoji: "🍺" },
  { name: "Ski Shops",         slug: "ski-shops",        emoji: "🎿" },
  { name: "Hiking Trails",     slug: "hiking",           emoji: "🥾" },
  { name: "Golf Courses",      slug: "golf",             emoji: "⛳" },
  { name: "Lodging Options",   slug: "lodging-options",  emoji: "🏠" },
  { name: "Adventure",         slug: "adventure",        emoji: "🧗" },
  { name: "Places to Drink",   slug: "places-to-drink",  emoji: "🥂" },
  { name: "Waterfalls",        slug: "waterfalls",       emoji: "💧" },
  { name: "Farm Visits",       slug: "farm-visits",      emoji: "🌾" },
  { name: "Museum Experience", slug: "museums",          emoji: "🏛️" },
  { name: "Nordic Ski",        slug: "nordic-ski",       emoji: "⛷️" },
  { name: "Cheese Shops",      slug: "cheese",           emoji: "🧀" },
  { name: "Covered Bridges",   slug: "bridges",          emoji: "🌉" },
  { name: "Bakery & Cafes",    slug: "cafe",             emoji: "☕" },
  { name: "Rock Climbing",     slug: "climbing",         emoji: "🪨" },
  { name: "Snowmobile Tours",  slug: "snowmobile",       emoji: "🏂" },
  { name: "Spa Day",           slug: "spa",              emoji: "💆" },
  { name: "Paddle Board",      slug: "sup",              emoji: "🏄" },
  { name: "Maple Sugar",       slug: "maple",            emoji: "🍁" },
  { name: "Grocery Markets",   slug: "grocery",          emoji: "🛒" },
  { name: "EV Charging",       slug: "ev-charging",      emoji: "⚡" },
];

const CATEGORIES = CATEGORIES_RAW.map(cat => {
  const count = allListings.filter((l: any) => getListingSlugs(l).includes(cat.slug)).length;
  return { ...cat, count };
});

const categoryColors: Record<string, string> = {
  'Skiing': '#0077A8',
  'Food & Drink': '#e74c3c',
  'Travel': '#16a085',
  'News': '#3498db',
  'Gear': '#f39c12',
  'Culture': '#9b59b6',
  'Adventure': '#27ae60',
  'Training': '#e67e22',
  'Research': '#34495e'
};

// Seasonal hero images (winter gets 10 images as the main season)
const SEASONAL_IMAGES = {
  winter: [
    { src: '/images/hero/hero-winter-2026.webp', alt: 'Killington World Cup Racing' },
    { src: '/images/hero/winter-activities-hero.webp', alt: 'Killington Winter Activities' },
    { src: '/images/hero/winter-3.webp', alt: 'Killington Winter Skiing' },
    { src: '/images/hero/winter-4.webp', alt: 'Killington Snow' },
    { src: '/images/hero/winter-5.jpg', alt: 'Killington Winter Mountain' },
    { src: '/images/hero/winter-6.png', alt: 'Killington Powder Day' },
    { src: '/images/hero/winter-7.webp', alt: 'Killington Slopes' },
    { src: '/images/hero/winter-8.jpg', alt: 'Killington Beast of the East' },
    { src: '/images/hero/winter-9.jpg', alt: 'Killington Winter Views' },
    { src: '/images/hero/winter-10.webp', alt: 'Killington Peak Winter' },
  ],
  summer: [
    { src: '/images/hero/summer-hero.webp', alt: 'Killington Summer' },
    { src: '/images/hero/summer-killington-aerial.webp', alt: 'Killington Aerial View' },
    { src: '/images/hero/summer-killington-bikers.webp', alt: 'Mountain Biking at Killington' },
    { src: '/images/hero/summer-killington-k1.webp', alt: 'K1 Gondola Summer' },
    { src: '/images/hero/summer-killington-mountains.webp', alt: 'Killington Mountain Views' },
  ],
  fall: [
    { src: '/images/hero/autumn-1.webp', alt: 'Killington Autumn' },
    { src: '/images/hero/killington-fall-2.webp', alt: 'Killington Fall Colors' },
    { src: '/images/hero/killington-fall-3.webp', alt: 'Killington Mountain Fall' },
    { src: '/images/hero/killington-fall-4.webp', alt: 'Killington Autumn Views' },
    { src: '/images/hero/killington-fall-5.webp', alt: 'Killington Fall Season' },
  ],
};

// Determine current season based on month
function getCurrentSeason(): 'winter' | 'summer' | 'fall' {
  const month = new Date().getMonth(); // 0-11
  // Winter: Nov(10), Dec(11), Jan(0), Feb(1), Mar(2), Apr(3)
  if (month >= 10 || month <= 3) return 'winter';
  // Fall: Sep(8), Oct(9)
  if (month >= 8 && month <= 9) return 'fall';
  // Summer: May(4), Jun(5), Jul(6), Aug(7)
  return 'summer';
}

const currentSeason = getCurrentSeason();
const heroImages = SEASONAL_IMAGES[currentSeason];

// Airbnb accommodations
const AIRBNB_LISTINGS = [
  { id: "17731360", title: "Killington Retreat | Deck-Fire Pit-Mountain Views!", rating: "4.94", guests: "4 guests", details: "2 bedrooms · 2 beds · 1 bath", location: "Clarendon, VT", img: "/images/accommodations/listing-1.webp", params: "guests=1&adults=1&s=66&source=embed_widget" },
  { id: "53130694", title: "Snow Better Place: Perfect for 2. Hot Tub", rating: "4.63", guests: "2 guests", details: "1 bedroom · 1 bed · 1 bath", location: "Killington, VT", img: "/images/accommodations/listing-2.webp", params: "check_in=2024-12-11&check_out=2024-12-16&guests=1&adults=2&s=66&source=embed_widget" },
  { id: "7452513", title: "Black haus: a hip, cool house hidden in a forest", rating: "4.95", guests: "2 guests", details: "1 bedroom · 1 bed · 1 bath", location: "Rochester, VT", img: "/images/accommodations/listing-3.webp", params: "check_in=2025-01-12&check_out=2025-01-17&guests=1&adults=2&s=66&source=embed_widget" },
  { id: "44573612", title: "Cozy VT Getaway w/ Hot Tub - 10 min to Killington", rating: "4.96", guests: "10 guests", details: "4 bedrooms · 7 beds · 2.5 baths", location: "Bridgewater, VT", img: "/images/accommodations/listing-4.webp", params: "check_in=2023-09-18&check_out=2023-09-23&guests=1&adults=1&s=66&source=embed_widget" },
  { id: "803737562629940238", title: "BearQuad- AC, Pool, Tennis, Close to Resort/Biking", rating: "5.0", guests: "10 guests", details: "4 bedrooms · 7 beds · 2 baths", location: "Killington, VT", img: "/images/accommodations/listing-5.webp", params: "guests=1&adults=1&s=66&source=embed_widget" },
  { id: "53217014", title: "Topridge 3BR w Incredible View & Private Hot Tub!", rating: "4.93", guests: "10 guests", details: "3 bedrooms · 6 beds · 4 baths", location: "Killington, VT", img: "/images/accommodations/listing-6.webp", params: "guests=1&adults=1&s=66&source=embed_widget" },
  { id: "614306371113185500", title: "CozyCub- Pool, AC, Hiking, Mountain Biking, Tennis", rating: "4.93", guests: "4 guests", details: "1 bedroom · 2 beds · 1 bath", location: "Killington, VT", img: "/images/accommodations/listing-7.webp", params: "guests=1&adults=1&s=66&source=embed_widget" },
  { id: "907840143992985986", title: "Cozy Condo- Close to Mountain, Ski home trail", rating: "4.83", guests: "4 guests", details: "1 bedroom · 2 beds · 1 bath", location: "Killington, VT", img: "/images/accommodations/listing-8.webp", params: "check_in=2025-03-12&check_out=2025-03-17&guests=1&adults=2&s=66&source=embed_widget" },
  { id: "19926145", title: "Serene Top Floor Condo (resort style amenities)", rating: "4.78", guests: "2 guests", details: "Studio · 1 bed · 1 bath", location: "Killington, VT", img: "/images/accommodations/listing-9.webp", params: "check_in=2024-12-20&check_out=2024-12-25&guests=1&adults=2&s=66&source=embed_widget" },
  { id: "13750563", title: "A Sweet Suite! Modern. Pool. 2RM/2BA. Shuttle. 532", rating: "4.89", guests: "6 guests", details: "1 bedroom · 3 beds · 2 baths", location: "Killington, VT", img: "/images/accommodations/listing-10.webp", params: "check_in=2024-12-11&check_out=2024-12-16&guests=1&adults=2&s=66&source=embed_widget" },
  { id: "50660535", title: "3BR at base of Pico Mountain!", rating: "4.92", guests: "8 guests", details: "3 bedrooms · 7 beds · 2 baths", location: "Killington, VT", img: "/images/accommodations/listing-11.webp", params: "check_in=2024-12-15&check_out=2024-12-20&guests=1&adults=2&s=66&source=embed_widget" },
  { id: "564541441919260459", title: "Fox Hollow Condo: Close to Killington. 2BR/2BA", rating: "4.76", guests: "6 guests", details: "2 bedrooms · 4 beds · 2 baths", location: "Mendon, VT", img: "/images/accommodations/listing-12.webp", params: "check_in=2024-12-11&check_out=2024-12-16&guests=1&adults=2&s=66&source=embed_widget" },
  { id: "1034742959619811054", title: "CubsCorner - Pool, Sauna, Gym, Close to Mountain!", rating: "4.87", guests: "3 guests", details: "1 bedroom · 2 beds · 1 bath", location: "Killington, VT", img: "/images/accommodations/listing-13.webp", params: "check_in=2024-12-11&check_out=2024-12-16&guests=1&adults=2&s=66&source=embed_widget" }
];

// Deals from Backcountry
const DEALS = [
  { name: "Osito Jacket - Women's", brand: "The North Face", price: "$55.00", url: "https://www.backcountry.com/the-north-face-osito-jacket-womens", img: "/images/deals/osito-jacket-isolated.png", rating: 5 },
  { name: "Odyssey Multi Short - Men's", brand: "Outdoor Research", price: "$59.00", url: "https://www.backcountry.com/outdoor-research-odyssey-multi-short-mens?skid=ODRZ937-WILATO", img: "/images/deals/odyssey-short-isolated.png", rating: 4.5 },
  { name: "SB120 C2 GX Eagle Mountain Bike", brand: "Yeti Cycles", price: "$3,775.00", url: "https://www.backcountry.com/yeti-cycles-sb120-c2-gx-eagle-mountain-bike", img: "/images/deals/yeti-sb120-isolated.png", rating: 5 },
  { name: "Freerider Pro Cycling Shoe - Men's", brand: "Five Ten", price: "$119.95", url: "https://www.backcountry.com/five-ten-freerider-pro-cycling-shoe-mens?skid=FVTZ145-CAOFWHCOBL", img: "/images/deals/five-ten-shoes-isolated.png", rating: 5 },
  { name: "Shift Split MAG ChromaPop Sunglasses", brand: "Smith", price: "$165.00", url: "https://www.backcountry.com/smith-shift-split-mag-chromapop-sunglasses", img: "/images/deals/smith-sunglasses-isolated.png", rating: 4.5 },
  { name: "Kortal Helmet", brand: "POC", price: "$120.97", url: "https://www.backcountry.com/poc-kortal-helmet", img: "/images/deals/poc-kortal.png", rating: 4.5 },
  { name: "Compressible Pillow Cinch", brand: "Therm-a-Rest", price: "$32.86 - $49.95", url: "https://www.backcountry.com/therm-a-rest-compressible-pillow-cinch", img: "/images/deals/therm-a-rest-pillow.webp", rating: 4.5 },
  { name: "Wireless 4 Tent: 4-Person 3-Season", brand: "Kelty", price: "$189.95", url: "https://www.backcountry.com/kelty-wireless-4-tent-4-person-3-season", img: "/images/deals/kelty-tent.png", rating: 4.5 },
  { name: "X Ultra 5 Mid GTX Hiking Boot - Men's", brand: "Salomon", price: "$189.95", url: "https://www.backcountry.com/salomon-x-ultra-5-mid-gtx-hiking-boot-mens", img: "/images/deals/salomon-boots.webp", rating: 4.5 },
  { name: "Mira 22L Hydration Backpack - Women's", brand: "Osprey Packs", price: "$140.00", url: "https://www.backcountry.com/osprey-packs-mira-22l-hydration-backpack-womens", img: "/images/deals/osprey-backpack.webp", rating: 5 },
  { name: "Classic Thermal Base Layer", brand: "Smartwool", price: "$115.00", url: "https://www.backcountry.com/smartwool-classic-thermal-merino-base-layer-crew-mens", img: "/images/deals/smartwool-base.webp", rating: 4.5 },
  { name: "Helium Rain Jacket - Men's", brand: "Outdoor Research", price: "$159.00", url: "https://www.backcountry.com/outdoor-research-helium-rain-jacket-mens", img: "/images/deals/helium-jacket.png", rating: 4.5 },
