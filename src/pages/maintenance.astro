---
// Maintenance page - noindex
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Down for Maintenance — Killington Getaway</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <style>
      :root {
        --brand-navy: #0B1619;
        --brand-green: #2d94e3;
        --brand-blue: #00B4D8;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
        background: var(--brand-navy);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .bg-decor {
        position: absolute;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        filter: blur(60px);
        animation: pulse 4s ease-in-out infinite;
      }
      .bg-decor-1 {
        top: 0;
        right: 0;
        transform: translate(50%, -50%);
        background: rgba(45, 148, 227, 0.1);
      }
      .bg-decor-2 {
        bottom: 0;
        left: 0;
        transform: translate(-50%, 50%);
        background: rgba(0, 180, 216, 0.1);
        animation-delay: 1s;
      }
      @keyframes pulse {
        0%, 100% { opacity: 0.5; }
        50% { opacity: 1; }
      }
      @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-20px); }
      }
      .icon-container {
        width: 8rem;
        height: 8rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3.5rem;
        margin: 0 auto 2.5rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        animation: bounce 2s ease-in-out infinite;
      }
      .error-code {
        font-family: 'Oswald', sans-serif;
        font-size: clamp(4rem, 15vw, 9rem);
        font-weight: 700;
        color: white;
        letter-spacing: -0.05em;
        line-height: 1;
        margin-bottom: 1rem;
      }
      .error-title {
        font-family: 'Oswald', sans-serif;
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 700;
        color: var(--brand-green);
        text-transform: uppercase;
        letter-spacing: -0.025em;
        margin-bottom: 2rem;
      }
      .error-title span { color: white; }
      .error-desc {
        color: rgba(255, 255, 255, 0.4);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.7;
        max-width: 32rem;
        margin: 0 auto 3rem;
      }
      .btn-group {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn {
        font-weight: 900;
        font-size: 0.7rem;
        padding: 1.25rem 3rem;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        text-decoration: none;
        transition: all 0.3s;
      }
      .btn-primary {
        background: var(--brand-green);
        color: white;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      }
      .btn-primary:hover { background: rgba(45, 148, 227, 0.9); }
      .btn-secondary {
        background: transparent;
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.2);
      }
      .btn-secondary:hover { background: rgba(255, 255, 255, 0.05); }
      .content { position: relative; z-index: 10; max-width: 40rem; }
    </style>
  </head>
  <body>
    <div class="bg-decor bg-decor-1"></div>
    <div class="bg-decor bg-decor-2"></div>

    <div class="content">
      <div class="icon-container">🔧</div>
      <div class="error-code">503</div>
      <h2 class="error-title">Grooming the <span>Trails</span></h2>
      <p class="error-desc">
        Killington Getaway is temporarily offline for scheduled maintenance. We'll have fresh corduroy ready for you shortly. Check back soon.
      </p>
      <div class="btn-group">
        <a href="/" class="btn btn-primary">Try Again</a>
        <a href="mailto:hello@killingtongetaway.com" class="btn btn-secondary">Email Support</a>
      </div>
    </div>
  </body>
</html>
