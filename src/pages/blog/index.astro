---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

// Get all blog posts, sorted by date (newest first)
// Filter out drafts and posts scheduled for the future
const now = new Date();
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => {
    if (post.data.draft) return false;
    // Check publishDate if set, otherwise use date
    const publishDate = post.data.publishDate ? new Date(post.data.publishDate) : new Date(post.data.date);
    return publishDate <= now;
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const featured = posts[0];
const rest = posts.slice(1);

const CATEGORY_COLORS: Record<string, string> = {
  'Adventure': '#2d94e3',
  'Skiing': '#3498DB',
  'Culture': '#0B1619',
  'Travel': '#2d94e3',
  'News': '#DC2626',
  'Research': '#3498DB',
  'Training': '#D97706',
  'Gear': '#EA580C',
  'Food & Drink': '#e74c3c',
};
---

<BaseLayout
  title="Blog - Stories & Insider Guides"
  description="Expert guides, local insights, and insider tips for making the most of your Killington experience - from skiing and snowboarding to year-round Vermont adventures."
>
  <main class="min-h-screen bg-white font-body">
    <Hero title="Stories & Insider Guides" subtitle="Inspiration, destination guides, and local knowledge from the heart of the Green Mountains." />

    <section class="py-24 px-6 bg-gray-50/50">
      <div class="max-w-7xl mx-auto">

        <!-- Featured post -->
        <a
          href={`/blog/${featured.slug}/`}
          class="group flex flex-col lg:flex-row gap-0 bg-white rounded-[3rem] overflow-hidden shadow-premium hover:shadow-2xl transition-all duration-500 mb-20 transform hover:-translate-y-2 border border-gray-50"
        >
          <div class="lg:w-3/5 h-80 lg:h-[500px] overflow-hidden relative">
            <img
              src={featured.data.image}
              alt={featured.data.title}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute top-8 left-8">
              <span class="bg-brand-green text-white text-[10px] font-black px-6 py-2.5 rounded-full uppercase tracking-widest shadow-xl">
                Featured Story
              </span>
            </div>
          </div>
          <div class="lg:w-2/5 p-12 lg:p-16 flex flex-col justify-center">
            <div class="flex items-center gap-4 mb-6">
              <span
                class="text-[10px] font-black px-4 py-1.5 rounded-full text-white uppercase tracking-widest shadow-lg"
                style={`background-color: ${CATEGORY_COLORS[featured.data.category] || '#2d94e3'}`}
              >
                {featured.data.category}
              </span>
              <span class="text-[10px] font-black text-gray-300 uppercase tracking-widest">
                {new Date(featured.data.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
              </span>
            </div>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-black text-brand-navy mb-6 leading-[1.1] tracking-tight group-hover:text-brand-green transition-colors">
              {featured.data.title}
            </h2>
            <p class="text-gray-500 text-lg font-medium leading-relaxed mb-10 line-clamp-3">{featured.data.excerpt}</p>
            <div class="mt-auto flex items-center justify-between">
              <div class="flex items-center gap-2 text-brand-green font-black text-xs uppercase tracking-widest group-hover:gap-4 transition-all">
                Full Story
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
              <span class="text-[10px] font-black text-gray-300 uppercase tracking-widest">By {featured.data.author}</span>
            </div>
          </div>
        </a>

        <!-- Grid Header -->
        <div class="flex items-center gap-4 mb-12">
          <h3 class="text-xl font-heading font-black text-brand-navy uppercase tracking-widest">More From The Guide</h3>
          <div class="flex-1 h-[2px] bg-gray-100"></div>
        </div>

        <!-- Rest of posts grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
          {rest.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="bg-white rounded-[2.5rem] overflow-hidden shadow-premium hover:shadow-2xl transition-all duration-500 group flex flex-col transform hover:-translate-y-2 border border-gray-50"
            >
              <div class="h-60 overflow-hidden relative">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute top-6 left-6">
                  <span class="bg-white/90 backdrop-blur-md text-brand-navy text-[10px] font-black px-4 py-1.5 rounded-full uppercase tracking-widest shadow-lg">
                    {post.data.category}
                  </span>
                </div>
              </div>
              <div class="p-8 lg:p-10 flex flex-col flex-1">
                <span class="text-[10px] font-black text-gray-300 uppercase tracking-widest mb-4">
                  {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
                </span>
                <h3 class="text-xl font-heading font-black text-brand-navy mb-4 leading-snug group-hover:text-brand-green transition-colors line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="text-gray-500 text-sm font-medium leading-relaxed flex-1 mb-8 line-clamp-2">{post.data.excerpt}</p>
                <div class="flex items-center gap-2 text-brand-green font-black text-xs uppercase tracking-widest group-hover:gap-3 transition-all">
                  Read More
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .shadow-premium {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
