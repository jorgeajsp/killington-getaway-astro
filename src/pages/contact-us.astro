---
import BaseLayout from '../layouts/BaseLayout.astro';

const SOCIALS = [
  { name: 'facebook', icon: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z', url: 'https://facebook.com/killingtongetaway' },
  { name: 'instagram', url: 'https://instagram.com/official_killingtongetaway', isStroke: true },
  { name: 'x', icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z', url: 'https://x.com/visitkillington' }
];
---

<BaseLayout
  title="Contact Us"
  description="Have questions or want to update a listing? Reach out to our local Killington experts."
>
  <main class="min-h-screen bg-white font-body">
    <!-- Header -->
    <section class="bg-white border-b border-gray-100 py-24 px-6 text-center overflow-hidden">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-3 mb-6">
          <span class="w-8 h-[2px] bg-brand-green"></span>
          <p class="uppercase tracking-[0.3em] text-xs font-black text-brand-navy/40">Connect With Us</p>
          <span class="w-8 h-[2px] bg-brand-green"></span>
        </div>
        <h1 class="text-5xl md:text-7xl font-heading font-black text-brand-navy mb-6 tracking-tight">Let's Start a <span class="text-brand-green">Conversation</span></h1>
        <p class="text-gray-400 text-xl font-medium max-w-2xl mx-auto">Questions, listing submissions, or just want to say hello — we're here to help you experience the best of Killington.</p>
      </div>
    </section>

    <section class="py-24 px-6 bg-gray-50/50">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-20">

        <!-- Contact Info -->
        <div class="flex flex-col gap-12">
          <div class="space-y-10">
            <div class="flex gap-6">
              <div class="w-14 h-14 rounded-2xl bg-brand-green/5 flex items-center justify-center flex-shrink-0 text-brand-green">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-[10px] font-black text-gray-300 uppercase tracking-widest mb-1">Call Us</p>
                <a href="tel:+19494366769" class="text-brand-navy font-bold text-lg hover:text-brand-green transition-colors">
                  (949) 436-SNOW
                </a>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="w-14 h-14 rounded-2xl bg-brand-blue/5 flex items-center justify-center flex-shrink-0 text-brand-blue">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-[10px] font-black text-gray-300 uppercase tracking-widest mb-1">Email Us</p>
                <a href="mailto:hello@killingtongetaway.com" class="text-brand-navy font-bold text-lg hover:text-brand-green transition-colors">
                  hello@killingtongetaway.com
                </a>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="w-14 h-14 rounded-2xl bg-brand-navy/5 flex items-center justify-center flex-shrink-0 text-brand-navy">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-[10px] font-black text-gray-300 uppercase tracking-widest mb-1">Based In</p>
                <p class="text-brand-navy font-bold text-lg">Killington, Vermont</p>
              </div>
            </div>
          </div>

          <div class="pt-10 border-t border-gray-100">
            <p class="text-[10px] font-black text-gray-300 uppercase tracking-widest mb-6">Social Connection</p>
            <div class="flex gap-5">
              <a
                href="https://facebook.com/killingtongetaway"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-2xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-brand-green hover:shadow-md transition-all group border border-gray-50"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="transform group-hover:scale-110 transition-transform">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                </svg>
              </a>
              <a
                href="https://instagram.com/official_killingtongetaway"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-2xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-brand-green hover:shadow-md transition-all group border border-gray-50"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transform group-hover:scale-110 transition-transform">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
                </svg>
              </a>
              <a
                href="https://x.com/visitkillington"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-2xl bg-white shadow-sm flex items-center justify-center text-gray-400 hover:text-brand-green hover:shadow-md transition-all group border border-gray-50"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="transform group-hover:scale-110 transition-transform">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Form Container -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-[3rem] p-10 lg:p-16 shadow-premium border border-gray-50">
            <form
              action="https://formspree.io/f/xwkgzgod"
              method="POST"
              class="space-y-8"
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-[10px] font-black text-gray-300 uppercase tracking-widest mb-3">Your Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full px-6 py-4 rounded-2xl border border-gray-100 focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 outline-none transition-all font-medium text-brand-navy"
                    placeholder="John Smith"
                  />
                </div>
                <div>
                  <label for="email" class="block text-[10px] font-black text-gray-300 uppercase tracking-widest mb-3">Email Address</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full px-6 py-4 rounded-2xl border border-gray-100 focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 outline-none transition-all font-medium text-brand-navy"
                    placeholder="john@example.com"
                  />
                </div>
              </div>

              <div>
                <label for="subject" class="block text-[10px] font-black text-gray-300 uppercase tracking-widest mb-3">Subject</label>
                <select
                  id="subject"
                  name="subject"
                  required
                  class="w-full px-6 py-4 rounded-2xl border border-gray-100 focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 outline-none transition-all font-medium text-brand-navy appearance-none bg-white"
                >
                  <option value="">Select a topic...</option>
                  <option value="general">General Inquiry</option>
                  <option value="listing">Add or Update a Listing</option>
                  <option value="partnership">Partnership Opportunity</option>
                  <option value="feedback">Feedback</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-[10px] font-black text-gray-300 uppercase tracking-widest mb-3">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  required
                  class="w-full px-6 py-4 rounded-2xl border border-gray-100 focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 outline-none transition-all font-medium text-brand-navy resize-none"
                  placeholder="Tell us how we can help..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full bg-brand-green text-white font-black px-12 py-5 rounded-full hover:bg-brand-green/90 transition-all shadow-xl uppercase tracking-widest text-sm"
              >
                Send Message
              </button>
            </form>
          </div>
        </div>

      </div>
    </section>
  </main>
</BaseLayout>
