---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TeamSlider from '../components/react/TeamSlider';
---

<BaseLayout
  title="Our Team"
  description="Meet the people behind Killington Getaway — entrepreneurs, Vermonters, and ski enthusiasts dedicated to helping you experience the best of Vermont."
>
  <main class="min-h-screen bg-white font-body overflow-x-hidden">

    <Hero
      title='<span class="text-white">Our</span> <span class="text-brand-green">Team</span>'
      subtitle="The People Behind the Guide"
      image="/images/team/team-hero.jpg"
    />

    <TeamSlider client:load />

    <!-- Mission Section -->
    <section class="bg-brand-navy border-t border-white/10 py-24 px-6 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-white/5 via-transparent to-transparent opacity-30"></div>
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <h2 class="text-4xl md:text-5xl font-heading font-black text-white tracking-tight uppercase mb-8">Our Mission</h2>
        <p class="text-gray-300 leading-relaxed text-xl md:text-2xl font-medium">
          Our mission is to share the magic of Vermont, encouraging and assisting fellow travelers to savor its boundless wonders. With a profound appreciation for our state's natural beauty and insatiable wanderlust, we're on a journey to help you discover Vermont at its absolute best.
        </p>
      </div>
    </section>

  </main>
</BaseLayout>
