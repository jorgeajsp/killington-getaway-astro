---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingGallery from '../../components/react/ListingGallery';
import ListingMap from '../../components/react/ListingMap';
import listingsData from '../../data/listings.json';

export function getStaticPaths() {
  const allListings = listingsData.filter((l: any) => !l.draft);

  return allListings.map((listing: any) => {
    const url = listing.url || '';
    const clean = url.replace(/\/$/, '');
    const parts = clean.split('/');
    const slug = parts[parts.length - 1] || listing.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');

    return {
      params: { slug },
      props: { listing },
    };
  });
}

interface Props {
  listing: any;
}

const { listing } = Astro.props;
const { slug } = Astro.params;

const img = listing.localImage || listing.image || null;
const allImages = [...new Set([img, ...(listing.gallery || [])].filter(Boolean))];

// Breadcrumb structured data for SEO
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://killingtongetaway.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Listings",
      "item": "https://killingtongetaway.com/listings"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": listing.name,
      "item": `https://killingtongetaway.com/listings/${slug}`
    }
  ]
};

// LocalBusiness structured data for SEO
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": listing.name,
  "description": listing.description || `${listing.name} in Killington, Vermont`,
  "url": `https://killingtongetaway.com/listings/${slug}`,
  "image": listing.localImage || listing.image || "https://killingtongetaway.com/opengraph-image.png",
  ...(listing.address && {
    "address": {
      "@type": "PostalAddress",
      "streetAddress": listing.address,
      "addressLocality": "Killington",
      "addressRegion": "VT",
      "addressCountry": "US"
    }
  }),
  ...(listing.phone && { "telephone": listing.phone }),
  ...(listing.website && { "sameAs": [listing.website] }),
  ...(listing.hours && { "openingHours": listing.hours }),
  "areaServed": {
    "@type": "Place",
    "name": "Killington, Vermont"
  }
};

const cleanDesc = listing.description
  ? listing.description.replace(/\r\n/g, ' ').substring(0, 155)
  : `Find details about ${listing.name} in Killington, Vermont including address, contact information, hours, and details.`;

const categoryColors = [
  'bg-brand-green border-brand-green/20 text-white',
  'bg-brand-blue border-brand-blue/20 text-white',
  'bg-orange-500 border-orange-500/20 text-white',
  'bg-purple-500 border-purple-500/20 text-white',
  'bg-pink-500 border-pink-500/20 text-white',
  'bg-teal-500 border-teal-500/20 text-white',
  'bg-brand-navy border-brand-navy/20 text-white'
];

function getCategoryColor(cat: string) {
  let hash = 0;
  for (let i = 0; i < cat.length; i++) hash = cat.charCodeAt(i) + ((hash << 5) - hash);
  return categoryColors[Math.abs(hash) % categoryColors.length];
}
---

<BaseLayout
  title={listing.name}
  description={cleanDesc}
  image={listing.localImage || listing.image || undefined}
>
  <main class="min-h-screen bg-white font-body">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Hero Section -->
    <div class="relative w-full pt-16 pb-12 overflow-hidden">
      <!-- Background image of Beast of the East -->
      <div class="absolute inset-0 z-0">
        <img
          src="/beast-of-the-east.png"
          alt="Killington Mountain"
          width="1600"
          height="400"
          class="w-full h-full object-cover object-center"
        />
      </div>
      <!-- Subtle background gradient overlay at ~40% -->
      <div class="absolute inset-0 bg-gradient-to-br from-brand-navy/60 via-brand-navy/40 to-brand-blue/20 z-0 mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-brand-navy/20 z-0"></div>

      <div class="relative max-w-6xl mx-auto px-6 z-10">
        <a
          href="/listings"
          class="inline-flex items-center gap-2 text-white/70 text-[10px] font-black uppercase tracking-[0.3em] mb-4 hover:text-white transition-colors group"
        >
          <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
            <path d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Explorer
        </a>

        <div class="flex flex-col md:flex-row gap-8 items-center justify-between text-center md:text-left">
          <div class="flex-1 w-full">
            <div class="flex flex-wrap justify-center md:justify-start gap-2 mb-4">
              {(listing.categories || []).map((cat: string) => (
                <span class={`glass text-[10px] font-black px-4 py-1.5 rounded-full uppercase tracking-widest shadow-lg border ${getCategoryColor(cat)}`}>
                  {cat}
                </span>
              ))}
            </div>

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-black text-white leading-[0.95] tracking-tight drop-shadow-xl">
              {listing.name}
            </h1>
          </div>

          {img && (
            <div class="w-full max-w-lg md:w-[400px] flex-shrink-0 z-10 relative mt-10 md:mt-0">
              <div class="bg-white/10 p-2 rounded-[2rem] shadow-2xl backdrop-blur-md border border-white/20 transform hover:scale-[1.02] transition-all duration-500">
                <div class="rounded-[1.5rem] overflow-hidden bg-white/5 shadow-inner">
                  <img
                    src={img}
                    alt={listing.name}
                    width="400"
                    height="300"
                    class="w-full h-auto object-cover display-block"
                  />
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="max-w-6xl mx-auto px-6 py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Left Column: Description -->
        <div class="lg:col-span-2">
          <div class="prose prose-xl prose-navy max-w-none">
            <div class="inline-flex items-center gap-3 mb-8">
              <span class="w-12 h-1 bg-brand-green rounded-full"></span>
              <h2 class="text-3xl font-heading font-black text-brand-navy tracking-tight uppercase">Overview</h2>
            </div>

            {listing.description ? (
              <p class="text-gray-500 text-xl font-medium leading-relaxed mb-4">
                {listing.description}
              </p>
            ) : (
              <p class="text-gray-400 italic text-xl font-medium mb-4">
                No description available for this location yet. We're currently updating our guide with more details.
              </p>
            )}

            <ListingGallery client:only="react" images={allImages} name={listing.name} />

            <ListingMap client:only="react" listing={listing} />
          </div>
        </div>

        <!-- Right Column: Info Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-[3rem] p-10 shadow-lg border border-gray-50 sticky top-32">
            <h3 class="text-xl font-heading font-black text-brand-navy mb-8 tracking-tight uppercase">Spot Details</h3>

            <div class="space-y-8 mb-12">
              {listing.address && (
                <div class="flex gap-5">
                  <div class="w-12 h-12 rounded-2xl bg-brand-green/5 flex items-center justify-center flex-shrink-0 text-brand-green">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  </div>
                  <div>
                    <p class="text-[10px] font-black text-gray-300 uppercase tracking-widest mb-1">Location</p>
                    <p class="text-brand-navy font-bold text-sm leading-snug">{listing.address}</p>
                  </div>
                </div>
              )}

              {listing.hours && (
                <div class="flex gap-5">
                  <div class="w-12 h-12 rounded-2xl bg-brand-blue/5 flex items-center justify-center flex-shrink-0 text-brand-blue">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                  </div>
                  <div>
                    <p class="text-[10px] font-black text-gray-300 uppercase tracking-widest mb-1">Hours</p>
                    <p class="text-brand-navy font-bold text-sm leading-snug">{listing.hours}</p>
                  </div>
                </div>
              )}

              {listing.phone && (
                <div class="flex gap-5">
                  <div class="w-12 h-12 rounded-2xl bg-brand-navy/5 flex items-center justify-center flex-shrink-0 text-brand-navy">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  </div>
                  <div>
                    <p class="text-[10px] font-black text-gray-300 uppercase tracking-widest mb-1">Phone</p>
                    <a href={`tel:${listing.phone.replace(/\D/g, '')}`} class="text-brand-navy font-bold text-sm hover:text-brand-green transition-colors">{listing.phone}</a>
                  </div>
                </div>
              )}
            </div>

            <div class="space-y-4">
              {listing.website && (
                <a
                  href={listing.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-3 bg-brand-green text-white font-black text-sm px-8 py-5 rounded-2xl hover:bg-brand-green/90 transition-all shadow-xl w-full uppercase tracking-widest"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  Visit Website
                </a>
              )}
              {listing.email && (
                <a
                  href={`mailto:${listing.email}`}
                  class="flex items-center justify-center gap-3 bg-brand-navy text-white font-black text-sm px-8 py-5 rounded-2xl hover:bg-brand-navy/90 transition-all shadow-xl w-full uppercase tracking-widest"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  Send Email
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
