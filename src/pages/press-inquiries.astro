---
import BaseLayout from '../layouts/BaseLayout.astro';
import PressInquiryForm from '../components/react/PressInquiryForm';

const COVERAGE_AREAS = [
  { topic: 'Killington Resort & Mountain', detail: 'Trail conditions, lift operations, snowmaking, events, and resort developments' },
  { topic: 'Vermont Ski Tourism', detail: 'Travel trends, accommodation market, visitor demographics and spending patterns' },
  { topic: 'B-Corp & Sustainable Tourism', detail: 'Our certification, giving back programs, and sustainable travel advocacy' },
  { topic: 'Northeast Ski Market Research', detail: 'Annual powder pursuits report, booking trends, and regional ski travel data' },
  { topic: 'Local Vermont Business', detail: 'Restaurant openings, lodging market, small business ecosystem in Killington corridor' },
  { topic: 'Mountain Biking & Summer Activities', detail: 'Killington Bike Park, summer tourism, and four-season destination development' },
];

const MEDIA_ASSETS = [
  { name: 'Brand Logos (PNG/SVG)', size: '2.4 MB', desc: 'Killington Getaway wordmark and icon in all color variants and formats' },
  { name: 'Team Photos', size: '8.1 MB', desc: 'High-resolution headshots and team photos of all five Killington Getaway team members' },
  { name: 'Mountain Photography', size: '45 MB', desc: "Licensed editorial photography of Killington Resort across all four seasons" },
  { name: 'B-Corp Certificate', size: '0.4 MB', desc: 'Official B Lab Certified B Corporation documentation and impact assessment summary' },
  { name: '2024 Powder Pursuits Report', size: '3.2 MB', desc: '1,000-respondent survey on northeastern ski travel trends and accommodation preferences' },
];
---

<BaseLayout
  title="Press Inquiries"
  description="For media inquiries, interview requests, licensing, and research partnerships — reach the Killington Getaway press team."
>
  <main class="min-h-screen bg-white font-body">

    <!-- Header -->
    <section class="bg-white border-b border-gray-100 py-24 px-6 overflow-hidden">
      <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1">
          <div class="inline-flex items-center gap-3 mb-6">
            <span class="w-8 h-[2px] bg-brand-green"></span>
            <p class="uppercase tracking-[0.3em] text-xs font-black text-brand-navy/40">Media Relations</p>
          </div>
          <h1 class="text-5xl md:text-7xl font-heading font-black text-brand-navy mb-8 tracking-tight uppercase leading-tight">Press <span class="text-brand-green">Inquiries</span></h1>
          <p class="text-gray-400 text-xl font-medium max-w-2xl leading-relaxed mb-10">
            For media inquiries, interview requests, licensing, and research partnerships — we're available and responsive.
          </p>
          <div class="flex flex-col gap-4">
            <a href="tel:+19494363766" class="flex items-center gap-4 text-brand-navy font-black text-lg hover:text-brand-green transition-colors group">
              <div class="w-12 h-12 rounded-full bg-brand-green/10 text-brand-green flex items-center justify-center group-hover:bg-brand-green group-hover:text-white transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <span class="uppercase tracking-widest text-sm">949-436-SNOW (7669)</span>
            </a>
            <a href="mailto:press@killingtongetaway.com" class="flex items-center gap-4 text-brand-navy font-black text-lg hover:text-brand-green transition-colors group">
              <div class="w-12 h-12 rounded-full bg-brand-green/10 text-brand-green flex items-center justify-center group-hover:bg-brand-green group-hover:text-white transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <span class="uppercase tracking-widest text-sm">press@killingtongetaway.com</span>
            </a>
          </div>
        </div>
        <div class="bg-brand-navy rounded-[3rem] p-10 lg:p-12 flex-shrink-0 w-full lg:w-96 shadow-2xl relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-brand-green/10 rounded-full -mr-16 -mt-16"></div>
          <h3 class="text-xl font-heading font-black text-white mb-8 uppercase tracking-tight relative z-10">Response Times</h3>
          <div class="flex flex-col gap-6 relative z-10">
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <span class="text-white/40 text-[10px] font-black uppercase tracking-widest">Broadcast / TV</span>
              <span class="text-brand-green text-xs font-black uppercase tracking-widest">Same day</span>
            </div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <span class="text-white/40 text-[10px] font-black uppercase tracking-widest">Print / Digital</span>
              <span class="text-brand-green text-xs font-black uppercase tracking-widest">Within 24h</span>
            </div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <span class="text-white/40 text-[10px] font-black uppercase tracking-widest">Research</span>
              <span class="text-brand-green text-xs font-black uppercase tracking-widest">Within 48h</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-white/40 text-[10px] font-black uppercase tracking-widest">Licensing</span>
              <span class="text-brand-green text-xs font-black uppercase tracking-widest">2–3 days</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Coverage areas -->
    <section class="py-24 px-6 bg-gray-50/30">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <h2 class="text-3xl md:text-5xl font-heading font-black text-brand-navy uppercase tracking-tight">We Can <span class="text-brand-green">Comment On</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {COVERAGE_AREAS.map((c) => (
            <div class="bg-white rounded-[2.5rem] p-8 border border-gray-100 hover:shadow-premium transition-all duration-500 group">
              <div class="w-12 h-12 rounded-2xl bg-brand-green/5 text-brand-green flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
              </div>
              <h3 class="text-xl font-heading font-black text-brand-navy mb-3 uppercase tracking-tight">{c.topic}</h3>
              <p class="text-gray-400 font-medium text-sm leading-relaxed">{c.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Media kit -->
    <section class="py-24 px-6 bg-white border-y border-gray-100">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 mb-16">
          <div>
            <h2 class="text-3xl md:text-5xl font-heading font-black text-brand-navy uppercase tracking-tight">Media <span class="text-brand-green">Kit</span></h2>
            <p class="text-gray-400 font-medium mt-2">Assets and documentation for editorial use.</p>
          </div>
          <a
            href="mailto:press@killingtongetaway.com?subject=Media Kit Request"
            class="bg-brand-navy text-white font-black px-10 py-4 rounded-full hover:bg-brand-green transition-all shadow-xl uppercase tracking-widest text-xs flex items-center gap-3"
          >
            Request Full Kit
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {MEDIA_ASSETS.map((asset) => (
            <div class="bg-gray-50/50 border border-gray-100 rounded-[2.5rem] p-8 flex items-center justify-between gap-8 group hover:bg-white hover:shadow-premium transition-all duration-500">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <p class="text-lg font-heading font-black text-brand-navy uppercase tracking-tight">{asset.name}</p>
                  <span class="text-[10px] font-black text-brand-green uppercase tracking-widest bg-brand-green/10 px-2 py-0.5 rounded">{asset.size}</span>
                </div>
                <p class="text-gray-400 font-medium text-sm leading-relaxed">{asset.desc}</p>
              </div>
              <a
                href="mailto:press@killingtongetaway.com?subject=Media Kit Request"
                class="w-12 h-12 rounded-full bg-white border border-gray-100 text-brand-navy flex items-center justify-center hover:bg-brand-navy hover:text-white transition-all shadow-sm"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Inquiry form -->
    <section class="py-24 px-6 bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-5xl font-heading font-black text-brand-navy uppercase tracking-tight mb-4">Submit an <span class="text-brand-green">Inquiry</span></h2>
          <p class="text-gray-400 text-lg font-medium">Preferred for complex or time-sensitive requests. Include your deadline below.</p>
        </div>
        <PressInquiryForm client:load />
      </div>
    </section>

  </main>
</BaseLayout>
